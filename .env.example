# GROQ_API_KEY: Required for Groq Cloud API calls (uses llama-3.3-70b-versatile for high-performance reasoning).
# In local development (VS Code), create a file named `.env` and paste your key here:
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime.
APP_URL="http://localhost:3000"
