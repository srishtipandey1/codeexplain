# Optional: required only for the existing Groq-powered analysis and chat features.
# Provider quotas and pricing depend on your account. Local search, suggestions, and evaluation need no key.
GROQ_API_KEY=your_groq_api_key_here

# Optional Groq model override (default: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# Optional application URL.
APP_URL=http://localhost:3000
